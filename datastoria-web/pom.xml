<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.ccweixiao.datastoria</groupId>
        <artifactId>datastoria-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>datastoria-web</artifactId>
    <packaging>pom</packaging>
    <name>DataStoria Web</name>
    <description>Next.js frontend static-export build and distribution module</description>

    <properties>
        <!-- Empty by default: the exported frontend is served same-origin by the
             Spring Boot backend. Set an absolute URL only for a separately
             hosted frontend pointing at a public Java origin. -->
        <datastoria.web.api-base-url/>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>npm-ci</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <executable>npm</executable>
                            <arguments>
                                <argument>ci</argument>
                                <argument>--force</argument>
                            </arguments>
                            <skip>${datastoria.web.skip}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <executable>npm</executable>
                            <arguments>
                                <argument>run</argument>
                                <argument>build</argument>
                            </arguments>
                            <environmentVariables>
                                <NEXT_PUBLIC_DATASTORIA_SESSION_BACKEND>java</NEXT_PUBLIC_DATASTORIA_SESSION_BACKEND>
                                <NEXT_PUBLIC_DATASTORIA_JAVA_API_BASE_URL>${datastoria.web.api-base-url}</NEXT_PUBLIC_DATASTORIA_JAVA_API_BASE_URL>
                            </environmentVariables>
                            <skip>${datastoria.web.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>${maven-assembly-plugin.version}</version>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/static-export.xml</descriptor>
                    </descriptors>
                    <skipAssembly>${datastoria.web.skip}</skipAssembly>
                    <tarLongFileMode>posix</tarLongFileMode>
                </configuration>
                <executions>
                    <execution>
                        <id>package-static-export</id>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <phase>package</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>web-dev</id>
            <properties>
                <datastoria.web.dev-api-base-url>http://127.0.0.1:8080</datastoria.web.dev-api-base-url>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>npm-ci-for-development</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <phase>initialize</phase>
                                <configuration>
                                    <executable>npm</executable>
                                    <arguments>
                                        <argument>ci</argument>
                                        <argument>--force</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>next-development-server</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <phase>generate-resources</phase>
                                <configuration>
                                    <executable>npm</executable>
                                    <arguments>
                                        <argument>run</argument>
                                        <argument>dev</argument>
                                    </arguments>
                                    <environmentVariables>
                                        <NEXT_PUBLIC_DATASTORIA_SESSION_BACKEND>java</NEXT_PUBLIC_DATASTORIA_SESSION_BACKEND>
                                        <NEXT_PUBLIC_DATASTORIA_JAVA_API_BASE_URL>${datastoria.web.dev-api-base-url}</NEXT_PUBLIC_DATASTORIA_JAVA_API_BASE_URL>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
