# Local development profile template.
#
# Copy this file to application-local.yaml and adjust values. The local
# application.yaml is gitignored to prevent committing secrets.
#
#   cp datastoria-boot/src/main/resources/application-local.yaml.example \
#      datastoria-boot/src/main/resources/application-local.yaml
#   ./mvnw -pl datastoria-boot -am package -DskipTests
#   SPRING_PROFILES_ACTIVE=local java -jar datastoria-boot/target/datastoria-boot-0.0.1-SNAPSHOT.jar
#
# Never commit real API keys, refresh tokens, database passwords, or ClickHouse
# credentials. The Java service is the only place secrets may live at runtime,
# and they must come from the environment or a secrets manager.

server:
  port: 8080

spring:
  datasource:
    url: "jdbc:sqlite:./data/datastoria.db"
    driver-class-name: org.sqlite.JDBC
    hikari:
      maximum-pool-size: 1

  flyway:
    enabled: true
    locations: classpath:db/migration/sqlite
    baseline-on-migrate: true

management:
  endpoints:
    web:
      exposure:
        include: health,info

# AES-256-GCM master key (base64-encoded 32 bytes) for dev secret encryption.
# Generate your own with: openssl rand -base64 32
# In production this comes from DATASTORIA_MASTER_KEY env var (never committed).
datastoria:
  agent:
    # Canonical repository root exposed read-only to search_file/read_file.
    repository-root: ${DATASTORIA_AGENT_REPOSITORY_ROOT:${user.dir}}
  master-key: AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
  skills:
    seed-enabled: true
  identity:
    default-tenant: tenant-local
    default-user: dev@example.com
    default-roles: ROLE_ADMIN,ROLE_USER
  cors:
    allowed-origins: http://localhost:3000,http://127.0.0.1:3000
