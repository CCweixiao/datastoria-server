{
  "name": "@datastoria/contract-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node contract runner and semantic diff for the DataStoria migration baseline.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "validate-fixtures": "node src/validate-fixtures.js",
    "validate-openapi": "redocly lint ../../docs/api/openapi-baseline.yaml --config ../../redocly.yaml",
    "test:unit": "node --test test/*.test.js",
    "test": "npm run validate-openapi && npm run validate-fixtures && npm run test:unit",
    "diff:captures": "node src/semantic-diff.js",
    "capture": "node src/capture.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@redocly/cli": "2.40.0"
  }
}
