# =============================================================================
# DataStoria 运行时配置 / DataStoria runtime configuration
#
# 复制为 conf/datastoria.env 后按目标环境调整；`bin/datastoria init` 首次运行会自动
# 复制并设置权限 0600。所有变量省略时使用注释中标注的默认值。
# Copy to conf/datastoria.env and adjust for the target environment; `bin/datastoria
# init` copies it automatically with 0600 on first run. Every variable falls back
# to the default noted in its comment when omitted.
#
# prod profile 必须配置：DATASTORIA_DB_URL/USERNAME/PASSWORD、DATASTORIA_JWT_SECRET、
# DATASTORIA_BOOTSTRAP_ADMIN_PASSWORD。其余变量均可选。
# Required when DATASTORIA_PROFILE=prod: DATASTORIA_DB_URL/USERNAME/PASSWORD,
# DATASTORIA_JWT_SECRET, DATASTORIA_BOOTSTRAP_ADMIN_PASSWORD. All others optional.
# =============================================================================

# -----------------------------------------------------------------------------
# 进程 / Process
# -----------------------------------------------------------------------------

# 运行 profile：dev=本地开发默认值；prod=生产（凭据由本文件提供）
# Runtime profile: dev = local development defaults; prod = production
# (credentials supplied by this file)
DATASTORIA_PROFILE=dev

# 后端监听地址 / Backend listen address
SERVER_HOST=0.0.0.0

# 后端监听端口 / Backend listen port
SERVER_PORT=8080

# JVM 启动参数 / JVM startup options
JAVA_OPTS="-Xms256m -Xmx1024m"

# JDK 17 安装目录（java 不在 PATH 时必填）
# Path to a JDK 17 install (required when java is not on PATH)
# JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home

# -----------------------------------------------------------------------------
# 数据库 / Database (MySQL 5.7)
# -----------------------------------------------------------------------------

# JDBC 连接串 / JDBC connection URL
DATASTORIA_DB_URL=jdbc:mysql://127.0.0.1:3306/datastoria?useSSL=false&serverTimezone=UTC&characterEncoding=utf8

# 数据库用户名 / Database username
DATASTORIA_DB_USERNAME=datastoria

# 数据库密码 / Database password
DATASTORIA_DB_PASSWORD=datastoria

# -----------------------------------------------------------------------------
# 认证 / Authentication (prod 必填 / required in prod)
# -----------------------------------------------------------------------------

# JWT 签名密钥：任意非空字符串（服务端做 SHA-256 派生）；prod 必须换成强随机值
# JWT signing secret: any non-empty string (SHA-256 derived server-side); must be
# a strong random value in prod
# DATASTORIA_JWT_SECRET=<random-long-secret>

# JWT 有效期（分钟），默认 480 / JWT lifetime in minutes, default 480
# DATASTORIA_JWT_TTL_MINUTES=480

# 首次启动引导创建的初始管理员账号（已存在则跳过）
# Bootstrap admin account created on first start (skipped when it already exists)
# 用户名 / username，默认 datastoria
# DATASTORIA_BOOTSTRAP_ADMIN_USERNAME=datastoria
# 密码 / password（prod 必填 / required in prod）
# DATASTORIA_BOOTSTRAP_ADMIN_PASSWORD=<strong-password>
# 角色 / role，默认 ADMIN
# DATASTORIA_BOOTSTRAP_ADMIN_ROLE=ADMIN
# 邮箱（可选）/ email (optional)
# DATASTORIA_BOOTSTRAP_ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# 多租户 / Multi-tenancy
# -----------------------------------------------------------------------------

# 默认租户标识，默认 default / Default tenant identifier, default "default"
# DATASTORIA_DEFAULT_TENANT=default

# -----------------------------------------------------------------------------
# 凭据加密 / Credential encryption
# -----------------------------------------------------------------------------

# 凭据主密钥（base64 编码的 32 字节 AES-256 key），用于加密 ClickHouse 连接密码和
# AI 供应商 API key。可省略：未设置时首次启动自动生成随机 key 写入 data/master.key
# （权限 0600）——务必备份该文件，丢失后已存凭据不可恢复。生产建议从密钥系统注入。
# Credential master key (base64-encoded 32-byte AES-256 key) encrypting ClickHouse
# connection passwords and AI provider API keys. Optional: when unset, a random key
# is generated into data/master.key (0600) on first start — back that file up,
# losing it makes stored credentials unrecoverable. Prefer injecting from a secret
# store in production.
# DATASTORIA_MASTER_KEY=<base64-32-byte-key>

# 主密钥文件路径，默认 data/master.key（相对安装根目录）
# Master key file path, default data/master.key (relative to the install root)
# DATASTORIA_MASTER_KEY_FILE=data/master.key

# 历史主密钥（逗号分隔 base64，仅解密用）。轮换主密钥后把旧 key 放这里，存量密文仍可
# 读取；确认无旧密文后可设为空串清除。默认包含本仓库历史上内置的两个 key。
# Legacy master keys (comma-separated base64, decrypt-only). After rotating the
# master key, keep the previous key here so existing ciphertexts stay readable;
# set to an empty string once no stored secret predates the rotation. Defaults to
# the two keys historically built into this repository.
# DATASTORIA_MASTER_KEY_LEGACY=

# -----------------------------------------------------------------------------
# CORS（仅前后端分离部署需要 / only for a separately hosted frontend）
# -----------------------------------------------------------------------------

# 前端独立域名时才配置；统一单进程部署前后端同源，无需 CORS（默认空=拒绝所有跨域）
# Only for a separately hosted frontend; the unified single-process deployment is
# same-origin and needs no CORS (empty default = deny all cross-origin access)
# DATASTORIA_CORS_ALLOWED_ORIGINS=https://app.example.com

# -----------------------------------------------------------------------------
# ClickHouse 查询安全限制 / ClickHouse query guardrails
# 普通用户 Query 与 Agent 查询共用；请求参数只能调小不能放宽，管理员不受限。
# Shared by regular-user queries and agent queries; request parameters can only
# tighten these, never loosen them. Admin queries are exempt.
# -----------------------------------------------------------------------------

# 强制只读（映射 readonly=2）。必须保持 true / Enforce read-only (readonly=2).
# Must stay true. 默认 true / default true
# DATASTORIA_QUERY_READ_ONLY=true

# 是否允许 DDL，默认 false / Allow DDL statements, default false
# DATASTORIA_QUERY_ALLOW_DDL=false

# 是否允许 introspection 函数，默认 false / Allow introspection functions,
# default false
# DATASTORIA_QUERY_ALLOW_INTROSPECTION_FUNCTIONS=false

# 单条查询最长执行时间（秒），默认 30 / Max query execution time in seconds,
# default 30
# DATASTORIA_QUERY_MAX_EXECUTION_TIME=30

# 返回结果最大行数，超限截断，默认 10000 / Max result rows, truncated when
# exceeded, default 10000
# DATASTORIA_QUERY_MAX_RESULT_ROWS=10000

# 返回结果最大字节数，超限截断，默认 10000000（约 10 MB） / Max result bytes,
# truncated when exceeded, default 10000000 (~10 MB)
# DATASTORIA_QUERY_MAX_RESULT_BYTES=10000000

# 最多扫描行数，超限终止查询，默认 10000000 / Max rows to read, query aborted
# when exceeded, default 10000000
# DATASTORIA_QUERY_MAX_ROWS_TO_READ=10000000

# 最多读取字节数，超限终止查询，默认 1000000000（约 1 GB） / Max bytes to read,
# query aborted when exceeded, default 1000000000 (~1 GB)
# DATASTORIA_QUERY_MAX_BYTES_TO_READ=1000000000

# 单条查询最大内存（字节），默认 1000000000（约 1 GB） / Max memory usage per query
# in bytes, default 1000000000 (~1 GB)
# DATASTORIA_QUERY_MAX_MEMORY_USAGE=1000000000

# 单条查询最大执行线程数，默认 4 / Max execution threads per query, default 4
# DATASTORIA_QUERY_MAX_THREADS=4

# -----------------------------------------------------------------------------
# ClickHouse 元数据缓存 / ClickHouse metadata cache
# -----------------------------------------------------------------------------

# 连接元数据缓存 TTL（ISO-8601 时长），默认 PT5M（5 分钟）/ Connection metadata
# cache TTL (ISO-8601 duration), default PT5M (5 minutes)
# DATASTORIA_CLICKHOUSE_METADATA_CACHE_TTL=PT5M

# 元数据缓存最大条目数，默认 1000 / Max cached metadata entries, default 1000
# DATASTORIA_CLICKHOUSE_METADATA_CACHE_MAXIMUM_SIZE=1000

# -----------------------------------------------------------------------------
# Agent / 其他 / misc
# -----------------------------------------------------------------------------

# Agent 运行时仓库根目录，默认进程工作目录（统一包=安装根目录）/ Agent runtime
# repository root, default process working directory (install root for the
# unified package)
# DATASTORIA_AGENT_REPOSITORY_ROOT=
