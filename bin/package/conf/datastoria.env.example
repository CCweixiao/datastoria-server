# Copy to datastoria.env and adjust for the target environment.
DATASTORIA_PROFILE=local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
JAVA_OPTS="-Xms256m -Xmx1024m"
# JAVA_HOME=/path/to/jdk-17

# Required for prod. Never commit the real values.
# DATASTORIA_DB_URL=jdbc:mysql://127.0.0.1:3306/datastoria?useSSL=true&serverTimezone=UTC
# DATASTORIA_DB_USERNAME=datastoria
# DATASTORIA_DB_PASSWORD=change-me
# DATASTORIA_MASTER_KEY=base64-encoded-32-byte-key
# DATASTORIA_CORS_ALLOWED_ORIGINS=http://your-host:3000
