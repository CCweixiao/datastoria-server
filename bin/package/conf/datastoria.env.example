# Copy to datastoria.env and adjust for the target environment.
DATASTORIA_PROFILE=dev
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
JAVA_OPTS="-Xms256m -Xmx1024m"
# JAVA_HOME=/path/to/jdk-17

# Dev defaults to the values below; override them when needed.
DATASTORIA_DB_URL=jdbc:mysql://127.0.0.1:3306/datastoria?useSSL=false&serverTimezone=UTC&characterEncoding=utf8
DATASTORIA_DB_USERNAME=datastoria
DATASTORIA_DB_PASSWORD=datastoria

# --- prod profile only (DATASTORIA_PROFILE=prod) ---
# Required: DATASTORIA_DB_URL/USERNAME/PASSWORD, DATASTORIA_JWT_SECRET,
# DATASTORIA_BOOTSTRAP_ADMIN_PASSWORD.
# Only for a separately hosted frontend (cross-origin); the unified single-process
# deployment is same-origin and needs no CORS:
# DATASTORIA_CORS_ALLOWED_ORIGINS=https://app.example.com
# Multi-tenant identifier (defaults to "default"):
# DATASTORIA_DEFAULT_TENANT=tenant-default
