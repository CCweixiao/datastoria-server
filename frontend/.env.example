# DataStoria browser UI
#
# The frontend contains no API routes and stores no application data or secrets. Every request is
# sent directly to the Spring Boot backend.

# Optional public URL / build-time base path.
# NEXT_PUBLIC_APP_URL=https://datastoria.example
# NEXT_PUBLIC_BASE_PATH=/app

# Required when Spring Boot is not available at the default URL.
NEXT_PUBLIC_DATASTORIA_JAVA_API_BASE_URL=http://127.0.0.1:8080

# Development only. Production identity is established by Spring Security and must not rely on a
# browser-supplied email header.
NEXT_PUBLIC_DATASTORIA_DEV_USER_EMAIL=dev@example.com
